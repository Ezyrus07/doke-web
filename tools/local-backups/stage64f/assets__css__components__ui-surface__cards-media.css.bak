/* Reusable page card normalization: service/media/profile cards. */
/* -------------------------------------------------------------------------
   Reusable page cards: announcement/media/profile cards. Scoped by class.
------------------------------------------------------------------------- */
:is(.service-card, .result-card, .profile-service-card, .pro-card, .comparison-card, .video-card, .media-card, .profile-card) {
  box-sizing: border-box;
  border: var(--border-soft);
  border-radius: var(--doke-card-radius);
  background: var(--doke-ui-bg);
  box-shadow: var(--doke-card-shadow);
  overflow: hidden !important;
}

:is(.service-card, .result-card, .profile-service-card) {
  width: min(100%, var(--doke-service-card-width)) !important;
  min-width: 0 !important;
}

:is(.service-card__media, .result-card__media, .profile-service-card__media) {
  min-height: var(--doke-service-card-media-height) !important;
  border-radius: calc(var(--doke-card-radius) - 8px);
  overflow: hidden !important;
}

:is(.service-card__favorite, .favorite-button, .heart-button, .video-card__play) {
  width: var(--doke-icon-button-size) !important;
  height: var(--doke-icon-button-size) !important;
  min-width: var(--doke-icon-button-size) !important;
  min-height: var(--doke-icon-button-size) !important;
  border-radius: var(--radius-pill);
  border: 1px solid rgba(255, 255, 255, 0.56);
  background: rgba(255, 255, 255, 0.92);
  color: var(--doke-ui-blue-800);
  display: inline-grid !important;
  place-items: center !important;
  box-shadow: 0 10px 22px rgba(16, 43, 74, 0.12);
}

:is(.service-card__favorite, .favorite-button, .heart-button, .video-card__play) :is(svg, img) {
  width: 18px !important;
  height: 18px !important;
}

:is(.video-card) {
  width: min(100%, var(--doke-worker-card-width)) !important;
  min-height: var(--doke-worker-card-height) !important;
}

:is(.comparison-card) {
  width: min(100%, var(--doke-comparison-card-width)) !important;
}

:is(.comparison-card__visual) {
  min-height: 156px !important;
}

:is(.profile-card, .pro-card) {
  border-radius: var(--radius-surface);
}

