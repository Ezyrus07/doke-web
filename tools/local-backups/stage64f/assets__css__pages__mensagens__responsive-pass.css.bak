/* 2026-04-21 responsive pass: messages tablet and small notebook stabilization */
@media (min-width: 761px) and (max-width: 1024px) {
  body.messages-page-shell .messages-app {
    grid-template-columns: 318px minmax(0, 1fr) !important;
    min-height: 100dvh !important;
    height: 100dvh !important;
  }

  body.messages-page-shell .messages-sidebar,
  body.messages-page-shell .messages-thread {
    min-height: 100dvh !important;
    height: 100dvh !important;
  }

  body.messages-page-shell .messages-sidebar {
    padding: 18px 16px;
  }

  body.messages-page-shell .messages-desktop-toolbar .orders-page-header__hero-strip,
  body.messages-page-shell .messages-desktop-toolbar .orders-page-header__hero-chips,
  body.messages-page-shell .messages-thread__actions {
    flex-wrap: wrap;
  }

  body.messages-page-shell .messages-thread__header {
    position: sticky;
    top: 0;
    z-index: 5;
  }

  body.messages-page-shell .messages-thread__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }

  body.messages-page-shell .messages-composer {
    position: sticky;
    bottom: 0;
    z-index: 6;
  }
}

@media (min-width: 1025px) and (max-width: 1365px) {
  body.messages-page-shell .messages-app {
    grid-template-columns: 350px minmax(0, 1fr) !important;
    min-height: 100dvh !important;
    height: 100dvh !important;
  }

  body.messages-page-shell .messages-sidebar,
  body.messages-page-shell .messages-thread {
    min-height: 100dvh !important;
    height: 100dvh !important;
  }

  body.messages-page-shell .messages-sidebar {
    padding: 20px 18px;
  }

  body.messages-page-shell .messages-thread__header {
    position: sticky;
    top: 0;
    z-index: 5;
  }

  body.messages-page-shell .messages-thread__body {
    flex: 1 1 auto;
    min-height: 0;
    overflow-y: auto;
  }

  body.messages-page-shell .messages-composer {
    position: sticky;
    bottom: 0;
    z-index: 6;
  }
}


