/* Results workers parity.
   Ownership: workers-only card sizing/rendering inside resultados.html.
   Goal: reuse the same media-only contract seen on index.html so worker cards
   stop rendering with stretched/cropped proportions on the results page. */

body.search-results-body {
  --results-worker-card-width-open: clamp(220px, 18vw, 258px);
  --results-worker-card-width-collapsed: clamp(220px, 17vw, 258px);
  --results-worker-card-gap: 22px;
  --results-worker-card-radius: 30px;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid {
  display: grid !important;
  align-items: start;
  align-content: start;
  justify-content: start;
  grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--results-worker-card-width-open)), var(--results-worker-card-width-open))) !important;
  gap: var(--results-worker-card-gap);
}

body.search-results-body .results-layout.is-filters-collapsed[data-results-mode="workers"] .results-grid {
  grid-template-columns: repeat(auto-fit, minmax(min(100%, var(--results-worker-card-width-collapsed)), var(--results-worker-card-width-collapsed))) !important;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card {
  position: relative !important;
  display: block !important;
  width: var(--results-worker-card-width-open) !important;
  max-width: 100% !important;
  min-width: 0 !important;
  min-height: 0 !important;
  aspect-ratio: 9 / 16 !important;
  padding: 0;
  overflow: hidden !important;
  border: var(--border-soft);
  border-radius: var(--results-worker-card-radius);
  background-color: #15314a;
  background-position: center;
  background-size: cover;
  background-repeat: no-repeat;
  box-shadow: 0 16px 34px rgba(15, 37, 60, 0.12);
  color: transparent;
  isolation: isolate !important;
  cursor: pointer;
  margin: 0;
}

body.search-results-body .results-layout.is-filters-collapsed[data-results-mode="workers"] .results-grid .video-card {
  width: var(--results-worker-card-width-collapsed) !important;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card::before,
body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card::after {
  content: none;
  display: none !important;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card > :not(.video-card__poster):not(.video-card__preview) {
  display: none !important;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card__poster,
body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card__preview {
  position: absolute !important;
  inset: 0 !important;
  width: 100% !important;
  height: 100% !important;
  object-fit: cover;
  border-radius: inherit;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card__poster {
  z-index: 0 !important;
  display: block !important;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card__preview {
  z-index: 1 !important;
  display: block !important;
  opacity: 0 !important;
  transition: opacity 180ms ease;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card.is-previewing .video-card__preview {
  opacity: 1 !important;
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card--one {
  background-image: url("../../../img/workers/worker-pintura.png");
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card--two {
  background-image: url("../../../img/workers/worker-cozinha.png");
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card--three {
  background-image: url("../../../img/workers/worker-eletrica.png");
}

body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card--four {
  background-image: url("../../../img/workers/worker-limpeza.png");
}

@media (hover: hover) and (pointer: fine) {
  body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card {
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card:hover,
  body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card:focus-visible,
  body.search-results-body .results-layout[data-results-mode="workers"] .results-grid .video-card.is-previewing {
    transform: translateY(-4px) !important;
    border-color: var(--border-color-selected);
    box-shadow: 0 20px 40px rgba(15, 37, 60, 0.18);
    outline: 0;
  }
}

@media (max-width: 1180px) {
  body.search-results-body {
    --results-worker-card-gap: 18px;
  }

  body.search-results-body .results-layout[data-results-mode="workers"] .results-grid,
  body.search-results-body .results-layout.is-filters-collapsed[data-results-mode="workers"] .results-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 220px)) !important;
  }
}

@media (max-width: 760px) {
  body.search-results-body {
    --results-worker-card-gap: 12px;
    --results-worker-card-radius: 24px;
  }

  body.search-results-body .results-layout[data-results-mode="workers"] .results-grid,
  body.search-results-body .results-layout.is-filters-collapsed[data-results-mode="workers"] .results-grid {
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 184px), 184px)) !important;
  }
}
