{
  "contract": "doke-navigation-lifecycle",
  "version": "9.0.0",
  "stage": "09-guarded-form-pending-surfaces",
  "sourceOfTruth": "docs/NAVIGATION-LIFECYCLE-CONTRACT.md",
  "excludedRuntimeSurfaces": [
    "comunidade-interna.html",
    "assets/js/pages/comunidade-interna.js",
    "assets/css/pages/comunidade-interna-foundation.css",
    "assets/css/pages/comunidade-interna.css"
  ],
  "invariants": [
    "At least one explicit surface must always be visible: document boot, ready static content, explicit guard/context pending, structural data skeleton, preserved content, or recoverable error.",
    "Protected content must not render before its guard resolves.",
    "Guarded forms and account-specific setup pages must use explicit pending surfaces instead of generic page skeletons.",
    "Internal navigation must not replay the document preloader.",
    "Mandatory authorization redirects must replace browser history.",
    "Operational pending feedback must not be implemented with page hydration or document boot surfaces.",
    "No artificial delay may be used as the primary synchronization mechanism."
  ],
  "authorities": {
    "navigationLifecycle": "assets/js/core/navigation-lifecycle.js",
    "documentBootAdapter": "assets/js/core/document-preloader.js",
    "pageLifecycleAdapter": "assets/js/core/page-hydration.js",
    "stableShellAdapter": "assets/js/core/stable-shell-router.js",
    "legacyShellAdapter": "assets/js/core/app.js",
    "navigationRegistry": "assets/js/core/navigation-registry.js",
    "authGuard": "assets/js/core/route-guard.js",
    "professionalGuard": "assets/js/services/professional-access-service.js",
    "operationalFeedback": "assets/js/components/operational-event-toast.js",
    "adminGuard": "assets/js/services/admin-access-service.js",
    "visualTiming": "assets/js/core/navigation-lifecycle.js#timing"
  },
  "entryModes": {
    "hard-load": {
      "history": "browser",
      "documentBoot": "conditional",
      "shell": "new-document",
      "content": "static-content-direct-or-explicit-context-pending-or-structural-data-skeleton-before-hydration"
    },
    "internal": {
      "history": "push",
      "documentBoot": "never",
      "shell": "preserve",
      "content": "direct-static-content-or-explicit-context-pending-or-structural-data-skeleton-or-previous-content"
    },
    "guard": {
      "history": "replace",
      "documentBoot": "never-after-shell-ready",
      "shell": "must-not-be-empty",
      "content": "guard-pending-surface-until-resolution"
    },
    "restore": {
      "history": "popstate",
      "documentBoot": "never-with-existing-shell",
      "shell": "preserve",
      "content": "restore-route-and-scroll"
    }
  },
  "priorityPages": [
    "index.html",
    "anunciar-servico.html",
    "verificacao-profissional.html",
    "tornar-profissional.html",
    "admin.html",
    "admin-verificacao.html",
    "meu-perfil.html",
    "perfil-profissional.html",
    "pedidos.html",
    "mensagens.html",
    "pagamento-profissional.html",
    "carteira.html",
    "configuracoes.html",
    "notificacoes.html",
    "orcamento.html",
    "avaliacao-profissional.html",
    "resultados.html",
    "detalhe-anuncio.html",
    "novidades.html",
    "ajuda.html"
  ],
  "mandatoryFlow": {
    "origin": "anunciar-servico.html",
    "condition": "publish_service denied because professional verification is required, pending, or rejected",
    "destination": "verificacao-profissional.html",
    "history": "replace",
    "requiredVisibleSequence": [
      "origin guard-pending surface",
      "destination account/context pending surface",
      "destination ready content or recoverable error"
    ]
  },
  "stage02": {
    "runtimeFacade": "assets/js/core/navigation-lifecycle.js",
    "globalApi": [
      "Doke.navigation.go",
      "Doke.navigation.warm",
      "Doke.navigation.guard",
      "Doke.navigation.transition",
      "Doke.pageLifecycle",
      "window.DokeNavigationLifecycle",
      "window.DokeNavigate"
    ],
    "adapterPriority": {
      "stable-shell": 100,
      "legacy-shell": 20,
      "document-fallback": 0
    },
    "ownsPopstate": true,
    "ownsEntryModeDetection": true,
    "scrollRestoration": "capture-before-navigation-and-restore-on-popstate",
    "guardMigrationStatus": "Professional guard migrated in Stage 03; admin dashboard and identity review migrated in Stage 04."
  },
  "stage03": {
    "flow": "anunciar-servico.html -> verificacao-profissional.html",
    "guard": "assets/js/services/professional-access-service.js",
    "status": "migrated"
  },
  "stage04": {
    "pages": [
      "admin.html",
      "admin-verificacao.html"
    ],
    "guard": "assets/js/services/admin-access-service.js",
    "requiredSequence": [
      "guard-pending skeleton",
      "allowed data hydration or mandatory replace redirect",
      "ready content or recoverable error"
    ],
    "status": "migrated"
  },
  "stage07": {
    "batch01": {
      "pages": [
        "carteira.html",
        "notificacoes.html",
        "orcamento.html",
        "avaliacao-profissional.html"
      ],
      "status": "migrated",
      "requiredSequence": [
        "carteira/notificacoes: structural data skeleton then ready, empty, or recoverable error",
        "orcamento/avaliacao: explicit account/context pending surface then ready or recoverable error"
      ]
    },
    "batch02": {
      "pages": [
        "resultados.html",
        "detalhe-anuncio.html",
        "novidades.html",
        "ajuda.html"
      ],
      "requiredSequence": [
        "resultados/detalhe: structural data skeleton then ready, empty, or recoverable error",
        "novidades/ajuda: direct static content; no page skeleton or hydration barrier"
      ],
      "status": "migrated"
    }
  },
  "stage08": {
    "status": "completed",
    "directInternalLocationMutations": 0,
    "visualTiming": "single shared cycle for document boot, route threshold and page hydration",
    "documentPreloaderOwner": "assets/js/core/document-preloader.js",
    "pageHydrationOwnsDocumentSplash": false,
    "legacyAdapters": "compatibility-only when navigation lifecycle is absent"
  },
  "stage09": {
    "pages": [
      "configuracoes.html",
      "orcamento.html",
      "avaliacao-profissional.html",
      "tornar-profissional.html",
      "verificacao-profissional.html"
    ],
    "policy": "guarded-or-context-dependent forms use explicit pending surfaces; no generic route skeleton",
    "routeCommit": "direct after required assets; page lifecycle remains a hydration barrier until ready or error",
    "status": "completed"
  }
}
