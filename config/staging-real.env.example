# Doke staging environment template
# Copy this file to .env.staging.local and fill values locally. Never commit real credentials.

DOKE_ENVIRONMENT=staging
DOKE_STAGING_API_URL=https://staging-api.example.local
DOKE_SUPABASE_DB_URL=postgres://user:password@localhost:5432/doke_staging
DOKE_STAGING_SEED_BINDER_CONFIRM=bind-staging-seeds
DOKE_STAGING_REAL_SEED_OPERATOR_EXECUTE=0
DOKE_STAGING_SEED_BINDER_EXECUTE=0

# Optional evidence flags used only after staging is ready.
DOKE_VISUAL_RESPONSIVE_EVIDENCE_EXECUTE=0
DOKE_BROWSER_QUALITY_EXECUTE=0
DOKE_LIGHTHOUSE_EXECUTE=0
DOKE_MANUAL_A11Y_REVIEW_COMPLETE=0
DOKE_PRIVATE_BETA_GO_LIVE_CONFIRM=
