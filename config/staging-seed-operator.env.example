# Doke staging seed operator template. Copy values into your local shell only.
# Never commit real database URLs, service keys, or production endpoints.
DOKE_ENVIRONMENT=staging
DOKE_STAGING_API_URL=https://staging-api.example.local
DOKE_SUPABASE_DB_URL=postgres://doke_user:replace-me@staging-db.example.local:5432/doke_staging
DOKE_STAGING_SEED_BINDER_CONFIRM=bind-staging-seeds
DOKE_STAGING_REAL_SEED_OPERATOR_EXECUTE=0
DOKE_STAGING_SEED_OPERATOR_ENV_RUN=0
