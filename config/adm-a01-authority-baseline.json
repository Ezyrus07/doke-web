  "findings": [
    {
      "id": "ADM-A01-F01",
      "severity": "critical",
      "category": "access_authority",
      "description": "Frontend admin access contains mock-support fallbacks and is not sufficient as operator authorization."
    },
    {
      "id": "ADM-A01-F02",
      "severity": "high",
      "category": "authority_split",
      "description": "The main admin controller combines local order/notification reads with remote domain repositories."
    },
    {
      "id": "ADM-A01-F03",
      "severity": "high",
      "category": "case_model",
      "description": "Users, identity, services, orders, payments, disputes, communities and content do not share one canonical case model."
    },
    {
      "id": "ADM-A01-F04",
      "severity": "high",
      "category": "audit_split",
      "description": "Financial, service moderation, identity and order operations expose separate audit streams without one correlation ledger."
    },
    {
      "id": "ADM-A01-F05",
      "severity": "high",
      "category": "rbac",
      "description": "Observed admin/support/moderator roles lack one canonical scoped permission matrix for every administrative action."
    },
    {
      "id": "ADM-A01-F06",
      "severity": "high",
      "category": "least_privilege",
      "description": "Time-bounded operator access, purpose binding and case-scoped grants are not universally enforced."
    },
    {
      "id": "ADM-A01-F07",
      "severity": "high",
      "category": "dual_control",
      "description": "High-risk identity, financial and account actions lack one cross-domain maker-checker policy."
    },
    {
      "id": "ADM-A01-F08",
      "severity": "medium",
      "category": "queue_fragmentation",
      "description": "Service moderation, verification, disputes and order operations use separate queues and navigation surfaces."
    },
    {
      "id": "ADM-A01-F09",
      "severity": "medium",
      "category": "reason_codes",
      "description": "Reason, evidence, before/after and correlation requirements are not normalized across all operator commands."
    },
    {
      "id": "ADM-A01-F10",
      "severity": "medium",
      "category": "appeals_sla",
      "description": "Unified notes, SLA, escalation and appeal handling remain incomplete."
    },
    {
      "id": "ADM-A01-F11",
      "severity": "medium",
      "category": "break_glass",
      "description": "No universal break-glass lifecycle with expiration, review and immutable evidence is defined."
    },
    {
      "id": "ADM-A01-F12",
      "severity": "medium",
      "category": "data_minimization",
      "description": "Operator views do not yet share one explicit field-minimization and sensitive-data masking contract."
    }
  ],
  "canonicalPrinciples": {
    "frontendAccessIsAuthorization": false,
    "mockSupportAllowed": false,
    "directDatabaseEditsAllowed": false,
    "unifiedCaseRequired": true,
    "correlationIdRequired": true,
