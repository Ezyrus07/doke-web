{
  "version": 1,
  "policy": {
    "description": "Baseline-aware structural gate. Historical debt must be explicit; new violations fail CI."
  },
  "manifests": {
    "markerPattern": "manifest|import-only|must not contain visual|no visual rules|orchestration",
    "headerScanCharacters": 1800
  },
  "storage": {
    "approvedOwnerPrefixes": [
      "assets/js/services/",
      "assets/js/repositories/",
      "assets/js/adapters/",
      "assets/js/data/",
      "assets/js/core/storage",
      "assets/js/core/session-snapshot"
    ],
    "approvedOwnerFiles": [
      "assets/js/core/auth-service.js",
      "assets/js/core/document-preloader.js",
      "assets/js/core/feature-flags.js",
      "assets/js/core/navigation-lifecycle.js",
      "assets/js/core/page-hydration.js",
      "assets/js/core/runtime-config.js",
      "assets/js/core/session.js",
      "assets/js/core/stable-shell-router.js",
      "assets/js/state/session-store.js"
    ],
    "ignoredPrefixes": [
      "assets/js/dev/"
    ]
  },
  "routes": {
    "owner": "assets/js/core/navigation-registry.js",
    "candidateMinimumRoutes": 3,
    "collectionMarkers": [
      "PAGE_CONFIGS",
      "ACTIVE_PATHS",
      "SAFE_ROUTES",
      "NATIVE_ROUTES",
      "HYDRATION_BARRIERS",
      "ROUTE_INIT",
      "routeMap",
      "routeConfig"
    ]
  },
  "globals": {
    "ignoredNames": [
      "Doke",
      "DokeOrders",
      "onclick",
      "onerror",
      "onload",
      "onresize",
      "onscroll"
    ]
  },
  "breakpoints": {
    "allowedValues": [
      760,
      761,
      1024,
      1025,
      1440
    ],
    "structuralFilePatterns": [
      "assets/js/core/.*shell.*\\.js$",
      "assets/js/core/.*router.*\\.js$",
      "assets/js/core/navigation-registry\\.js$",
      "assets/js/ui/mobile-drawer.*\\.js$",
      "assets/js/components/mobile-app-shell\\.js$"
    ]
  },
  "existingAudits": [
    "scripts/audit-navigation-registry-contract.js",
    "scripts/audit-responsive-boundaries.js"
  ],
