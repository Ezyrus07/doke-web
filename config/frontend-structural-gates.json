{
  "version": 1,
  "policy": {
    "description": "Baseline-aware structural gate. Historical debt must be explicit; new violations fail CI."
  },
  "manifests": {
    "markerPattern": "manifest|import-only|must not contain visual|no visual rules|orchestration",
    "headerScanCharacters": 1800
  },
  "storage": {
    "approvedOwnerPrefixes": [
      "assets/js/services/",
      "assets/js/repositories/",
      "assets/js/adapters/",
      "assets/js/data/",
      "assets/js/core/storage",
      "assets/js/core/session-snapshot"
    ]
  },
  "routes": {
    "owner": "assets/js/core/navigation-registry.js",
    "candidateMinimumRoutes": 3,
    "collectionMarkers": [
      "PAGE_CONFIGS",
      "ACTIVE_PATHS",
      "SAFE_ROUTES",
      "NATIVE_ROUTES",
      "HYDRATION_BARRIERS",
      "ROUTE_INIT",
      "routeMap",
      "routeConfig"
    ]
  },
  "globals": {
    "ignoredNames": [
      "onload",
      "onerror",
      "onscroll",
      "onresize",
      "onclick"
    ]
  },
  "breakpoints": {
    "allowedValues": [760, 761, 1024, 1025, 1440],
    "structuralFilePatterns": [
      "assets/js/core/.*shell.*\\.js$",
      "assets/js/core/.*router.*\\.js$",
      "assets/js/core/navigation-registry\\.js$",
      "assets/js/ui/mobile-drawer.*\\.js$",
      "assets/js/components/mobile-app-shell\\.js$"
    ]
  },
  "existingAudits": [
    "scripts/audit-navigation-registry-contract.js",
    "scripts/audit-responsive-boundaries.js"
  ],
  "baseline": {
    "cssMissingAssets": [],
    "cssCycles": [],
    "cssDuplicateAssets": [
      "assets/css/core/index.css",
      "assets/css/layout/header.css",
      "assets/css/layout/page-rail-authority.css",
      "assets/css/components/buttons.css",
      "assets/css/components/domain/doke-domain-cards.css",
      "assets/css/components/flows/doke-product-flows.css",
      "assets/css/components/forms/form-controls.css",
      "assets/css/components/identity/avatar.css",
      "assets/css/components/layout/doke-layout-system.css",
      "assets/css/components/layout/marketplace-index-layout-contract.css",
      "assets/css/components/layout/overflow-text-clipping-contract.css",
      "assets/css/components/overlays/modal-visual-contract.css",
      "assets/css/components/sections/section-header-canonical-contract.css",
      "assets/css/components/shell/desktop-base-stability.css",
      "assets/css/components/shell/mobile-base-stability.css",
      "assets/css/components/shell/responsive-boundary.css",
      "assets/css/components/states/empty-state-system.css",
      "assets/css/components/cards/ad-card.css",
      "assets/css/components/cards/marketplace-card-contract.css",
      "assets/css/components/cards/publication-card.css",
      "assets/css/components/cards/service-card.css",
      "assets/css/components/cards/worker-card.css",
      "assets/css/components/ui-surface/close-button-authority.css"
    ],
    "cssVersionDivergenceAssets": [
      "assets/css/core/index.css",
      "assets/css/layout/header.css",
      "assets/css/layout/page-rail-authority.css",
      "assets/css/components/buttons.css",
