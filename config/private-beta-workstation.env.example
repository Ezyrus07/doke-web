# Doke private beta workstation evidence template.
# Copy values manually in PowerShell; do not commit real credentials.

# Required to install Playwright-managed Chromium locally.
DOKE_PLAYWRIGHT_MANAGED_CHROMIUM_INSTALL=1

# Required for capture-only visual evidence. This must not update baselines.
DOKE_VISUAL_RESPONSIVE_EVIDENCE_EXECUTE=1
DOKE_VISUAL_EVIDENCE_CAPTURE_ONLY=1
DOKE_VISUAL_EVIDENCE_DIR=test-results/visual-evidence

# Set only after screenshots are reviewed manually.
DOKE_VISUAL_REVIEW_APPROVED=1
DOKE_VISUAL_REVIEWER=Gabriel

# Lighthouse/Core Web Vitals and accessibility evidence.
DOKE_LIGHTHOUSE_EXECUTE=1
DOKE_LIGHTHOUSE_TARGET_URL=http://127.0.0.1:4173/index.html
DOKE_MANUAL_A11Y_REVIEW_COMPLETE=1
DOKE_A11Y_REVIEWER=Gabriel

# Staging. Fill only after real staging exists.
DOKE_ENVIRONMENT=staging
DOKE_STAGING_API_URL=https://staging-api.example
DOKE_SUPABASE_DB_URL=postgres://REPLACE_WITH_STAGING_DB_URL
DOKE_STAGING_SEED_BINDER_CONFIRM=bind-staging-seeds
DOKE_STAGING_REAL_SEED_OPERATOR_EXECUTE=1

# Private beta GO. Set only after all reports are approved.
DOKE_PRIVATE_BETA_REAL_ENTRY_CONFIRM=enter-private-beta
DOKE_PRIVATE_BETA_REAL_ENTRY_REPEAT_FULL=1
