{
  "version": "global-cycle-54",
  "purpose": "Automatable visual baseline for the critical marketplace pages before removing sensitive CSS.",
  "baseUrl": "http://127.0.0.1:5500",
  "pages": [
    {
      "key": "index",
      "path": "index.html",
      "mustKeep": [
        "desktop shell/sidebar alignment",
        "home topbar/search geometry",
        "service cards",
        "workers rail",
        "publications rail",
        "mobile shell and bottom navigation"
      ]
    },
    {
      "key": "resultados",
      "path": "resultados.html",
      "mustKeep": [
        "desktop shell/sidebar alignment",
        "search/filter region",
        "service result cards",
        "mobile result width",
        "mobile shell and bottom navigation"
      ]
    },
    {
      "key": "perfil",
      "path": "perfil.html",
      "mustKeep": [
        "desktop shell/sidebar alignment",
        "profile cover/header",
        "profile identity/actions",
        "profile tabs",
        "services/workers/publications/reviews areas",
        "mobile profile card and tab width"
      ]
    }
  ],
  "viewports": [
    { "name": "mobile-380", "width": 380, "height": 844, "kind": "mobile", "isMobile": true, "hasTouch": true },
    { "name": "mobile-430", "width": 430, "height": 932, "kind": "mobile", "isMobile": true, "hasTouch": true },
    { "name": "desktop-1440", "width": 1440, "height": 900, "kind": "desktop", "isMobile": false, "hasTouch": false },
    { "name": "desktop-1920", "width": 1920, "height": 1080, "kind": "desktop", "isMobile": false, "hasTouch": false }
  ],
  "governance": {
    "beforeSensitiveCssRemoval": [
      "run npm run audit:critical-visual-baseline",
      "start the project locally at http://127.0.0.1:5500",
      "run npm run visual:critical-baseline to create/update snapshots intentionally",
      "run npm run visual:critical-check before accepting the CSS cleanup"
    ],
    "doNotUseFor": [
      "proving final visual design of pages still in redesign",
      "replacing manual product/design review"
    ]
  }
}
